# ============================================
# SHIVINFRA PRODUCTION CONFIGURATION
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --------------------------------------------
# APPLICATION
# --------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --------------------------------------------
# JWT AUTHENTICATION (REQUIRED)
# --------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# --------------------------------------------
# SUPABASE (REQUIRED)
# --------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# GEMINI AI (REQUIRED FOR AI FEATURES)
# --------------------------------------------
GEMINI_API_KEY=

# --------------------------------------------
# OPENAI (OPTIONAL)
# --------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------
# WHATSAPP BUSINESS API (REQUIRED FOR WHATSAPP)
# --------------------------------------------
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
WHATSAPP_MOCK_MODE=false
WHATSAPP_ALLOW_UNREGISTERED=false
WHATSAPP_API_VERSION=v18.0

# --------------------------------------------
# FACEBOOK MESSENGER (REQUIRED FOR FACEBOOK BROADCAST)
# --------------------------------------------
META_API_VERSION=v18.0
META_FB_PAGE_ID=
META_FB_PAGE_ACCESS_TOKEN=

# --------------------------------------------
# INSTAGRAM MESSAGING (REQUIRED FOR INSTAGRAM BROADCAST)
# --------------------------------------------
META_IG_ACCOUNT_ID=
META_IG_ACCESS_TOKEN=

# --------------------------------------------
# SMS / TEXT MESSAGING (REQUIRED FOR SMS BROADCAST)
# --------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_FROM=
SMS_ACCOUNT_SID=
SMS_API_KEY=
SMS_ENDPOINT=

# --------------------------------------------
# DEFAULT COMPANY (FOR WHATSAPP USER RESOLUTION)
# --------------------------------------------
DEFAULT_COMPANY_ID=
ADMIN_WHATSAPP=

# --------------------------------------------
# GOOGLE OAUTH (REQUIRED FOR GOOGLE INTEGRATION)
# --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google/oauth/callback
GOOGLE_REFRESH_TOKEN=

# --------------------------------------------
# GOOGLE SERVICES (OPTIONAL)
# --------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_BILLS_SPREADSHEET_ID=

# --------------------------------------------
# MATERIAL SEARCH PROVIDER
# --------------------------------------------
MATERIAL_SEARCH_PROVIDER=locationiq
LOCATIONIQ_API_KEY=
